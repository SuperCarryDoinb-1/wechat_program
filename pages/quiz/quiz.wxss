.quiz-page { padding: calc(24rpx + 3vh) 32rpx 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.quiz-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.quiz-header .brand { font-size: 72rpx; flex-shrink: 0; }
.progress-heading { display: flex; align-items: baseline; color: #505050; font-size: 12px; }
.current-number { color: #202020; font-weight: 800; font-size: 24px; margin: 0 4px; }
.progress-track { margin-top: 20rpx; height: 8px; border: 2px solid #202020; border-radius: 4px; background: #FFFFFF; overflow: hidden; }
.progress-fill { height: 100%; background: #C9B6FF; border-radius: 0; transition: width 180ms ease; }
.scene-card { position: relative; min-height: 104rpx; height: auto; margin: 20rpx 0; border: 2px solid #202020; border-radius: 8px; background: #FFE17D; display: flex; align-items: center; justify-content: center; padding: 8rpx 20rpx; overflow: hidden; }
.scene-visual { position: relative; width: 90rpx; height: 70rpx; flex-shrink: 0; }
.scene-image { display: block; width: 100%; height: 100%; }
.scene-art { position: absolute; top: 0; left: 0; width: 180rpx; height: 140rpx; transform: scale(.5); transform-origin: top left; }
.scene-caption { display: block; flex: 0 1 auto; min-width: 0; max-width: calc(100% - 106rpx); margin-left: 16rpx; font-size: 14px; line-height: 1.5; text-align: center; overflow-wrap: break-word; }
.scene-visual, .scene-caption { position: relative; left: -20rpx; }
.art-orbit { position: absolute; width: 152rpx; height: 96rpx; border: 1px solid currentColor; border-radius: 50%; opacity: .3; top: 20rpx; left: 8rpx; transform: rotate(-25deg); }
.art-body { position: absolute; width: 74rpx; height: 92rpx; border: 3rpx solid currentColor; border-radius: 12rpx; left: 52rpx; top: 20rpx; background: #FFFFFF; box-shadow: none; }
.art-line { height: 4rpx; background: currentColor; position: absolute; left: 14rpx; border-radius: 4rpx; }
.line-one { width: 38rpx; top: 24rpx; }
.line-two { width: 28rpx; top: 42rpx; opacity: .55; }
.art-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; position: absolute; bottom: 14rpx; right: 14rpx; }
.art-star { width: 16rpx; height: 16rpx; background: currentColor; position: absolute; top: 16rpx; right: 20rpx; transform: rotate(45deg); border-radius: 3rpx; }
.motif-chat .art-body { width: 96rpx; height: 68rpx; border-radius: 28rpx 28rpx 28rpx 4rpx; top: 34rpx; left: 40rpx; }
.motif-search .art-body { width: 76rpx; height: 76rpx; border-radius: 50%; }
.motif-search .line-two { width: 40rpx; transform: rotate(45deg); left: 58rpx; top: 76rpx; opacity: 1; }
.motif-photo .art-body { width: 110rpx; height: 78rpx; left: 30rpx; top: 30rpx; }
.motif-photo .line-one { width: 44rpx; height: 34rpx; transform: rotate(-25deg); top: 28rpx; opacity: .35; }
.motif-pause .line-one, .motif-pause .line-two { width: 8rpx; height: 42rpx; top: 22rpx; opacity: 1; }
.motif-pause .line-two { left: 42rpx; }
.question-title { font-size: 36rpx; font-weight: 800; line-height: 1.5; overflow-wrap: break-word; letter-spacing: 0; }
.options { display: inline-flex; flex-direction: column; align-items: stretch; vertical-align: top; width: auto; max-width: 100%; min-width: 0; box-sizing: border-box; padding-right: 3px; text-align: left; }
.options .option { display: flex; align-items: center; box-sizing: border-box; width: auto; max-width: 100%; min-width: 0; min-height: 60px; text-align: left; padding: 30rpx 32rpx; margin: 0 0 38.4rpx; border: 2px solid #202020; border-radius: 8px; box-shadow: 3px 3px 0 #202020; background: #FFF; color: #202020; font-weight: 400; letter-spacing: 0; line-height: 1.5; overflow: hidden; transition: background-color 120ms, transform 120ms; }
.option[disabled] { color: #202020; background: #FFF; }
.option.option-selected, .option.option-selected[disabled] { border-color: #202020; background: #C9B6FF; color: #202020; box-shadow: none; transform: translate(2px, 2px); }
.option-label { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 20rpx; border: 1px solid #202020; border-radius: 5px; font-size: 24rpx; color: #505050; font-weight: 700; background: #FFF4DA; }
.option-selected .option-label { color: #FFFFFF; background: #202020; border-color: #202020; }
.option-text { display: block; flex: 1 1 auto; width: auto; min-width: 0; max-width: 100%; font-size: 30rpx; text-align: left; letter-spacing: 0; white-space: nowrap; word-break: normal; overflow-wrap: normal; overflow: hidden; text-overflow: ellipsis; }
.quiz-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 32rpx; padding-top: 20rpx; border-top: 1px solid #202020; }
.quiz-nav { width: 200rpx; min-height: 44px; padding: 10px 12px; margin: 0; border: 2px solid #202020; border-radius: 8px; background: #FFFFFF; color: #202020; font-size: 14px; font-weight: 700; line-height: 1.5; flex-shrink: 0; }
.quiz-nav.next { background: #FFE17D; }
.quiz-nav[disabled] { color: #AEAEB2; border-color: #C8C3B8; background: #F2EAD8; }
.submit-error { color: #924817; font-size: 14px; line-height: 1.6; margin-top: 20rpx; padding: 20rpx; background: #FFF2DF; border-radius: 18rpx; }
.submit-error .secondary { margin-top: 16rpx; }
.question-stage { opacity: 1; text-align: center; }
@media (max-height: 600px) { .quiz-page { padding-top: calc(16rpx + 2vh); } }
@media (max-width: 340px) { .scene-card { min-height: 96rpx; margin: 16rpx 0; padding: 8rpx 16rpx; } .scene-caption { font-size: 13px; } .question-title { font-size: 17px; } }
@media (prefers-reduced-motion: reduce) { .question-stage { animation: none; } .option, .progress-fill { transition: none; } }
.question-title { margin: 0 12rpx 24rpx; text-align: left; }
.options .option:last-child { margin-bottom: 0; }
