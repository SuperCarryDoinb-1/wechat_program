@import "../../utils/type-preview.wxss";
@font-face { font-family: 'AITI Bungee'; font-style: normal; font-weight: 400; src: url('data:font/ttf;base64,') format('truetype'); }
.home-page { display: flex; flex-direction: column; min-height: 100vh; padding-top: 44rpx; }
.home-page > view { flex-shrink: 0; }
.home-page .brand-row { margin-right: 4px; justify-content: center; gap: 28rpx; }
.home-page .brand-avatar { display: block; width: 136rpx; height: 136rpx; flex-shrink: 0; border-radius: 32rpx; }
.home-page .brand { display: inline-block; flex-shrink: 0; font-family: 'AITI Bungee', sans-serif; font-weight: 400; font-size: 104rpx; letter-spacing: -0.25px; }
.brand-chatgpt { color: #45AF9B; }
.brand-claude { color: #FF916B; }
.brand-deepseek { color: #6FB7F6; }
.brand-kimi { color: #343438; }
.hero-heading { margin: 36rpx 0 0; text-align: center; }
.hero-heading .title { font-size: 50.83rpx; font-weight: 800; line-height: 1.5; letter-spacing: -0.5rpx; white-space: nowrap; }
.title-prefix, .title-emphasis { display: inline; }
.title-emphasis { text-decoration: none; }
.hero-heading .subtitle { margin-top: 18rpx; font-size: 28rpx; line-height: 1.8; }
.start-area { margin: 0 4px 0 0; padding-top: 28rpx; }
.start-button { display: flex; align-items: center; justify-content: center; min-height: 52px; padding: 24rpx; font-size: 17px; font-weight: 800; background: #FFE17D; }
.start-effort { margin-top: 20rpx; text-align: center; color: #505050; font-size: 12px; line-height: 1.6; }
.history-button { width: 100%; margin-top: 20rpx; min-height: 44px; padding: 18rpx 24rpx; line-height: 1.5; font-size: 15px; font-weight: 700; color: #202020; background: #D5EEE5; border: 2px solid #202020; border-radius: 8px; box-shadow: 3px 3px 0 #202020; }
.identity-samples { margin: 42rpx 4px 0 0; }
.samples-heading { display: flex; align-items: center; justify-content: center; text-align: center; gap: 12rpx; margin-bottom: 20rpx; }
.hidden-hint { color: #8B5B2E; font-size: 23rpx; line-height: 1.6; margin-bottom: 16rpx; }
.samples-title { font-size: 17px; line-height: 1.5; font-weight: 700; }
.samples-label { font-size: 12px; color: #505050; flex-shrink: 0; }
.home-disclaimer { margin-top: 28rpx; text-align: center; font-size: 12px; line-height: 1.8; color: #505050; }
.home-page .footer { margin-top: 20rpx; }
.diagnostics { margin-top: 36rpx; }
.diagnostics-title { font-size: 14px; margin-bottom: 8rpx; }
.diagnostics .secondary { margin: 20rpx 0; }
.friend-banner { display: flex; gap: 16rpx; margin-top: 24rpx; padding: 22rpx; background: #C9B6FF; border: 2px solid #202020; border-radius: 8px; color: #202020; line-height: 1.6; font-size: 14px; }
.friend-symbol { font-size: 36rpx; }
.privacy-link { color: #202020; background: transparent; font-size: 12px; padding: 12rpx; line-height: 2; text-decoration: none; }
@media (max-width: 340px) { .home-page { padding-top: 32rpx; } .hero-heading { margin-top: 36rpx; } .sample-card { gap: 18rpx; padding: 20rpx; } }
