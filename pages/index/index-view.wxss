@font-face { font-family: 'AITI Bungee'; font-style: normal; font-weight: 400; src: url('data:font/ttf;base64,') format('truetype'); }
.home-page { padding-top: calc(24rpx + 6vh); }
.home-page .brand-row, .home-page .hero-heading { position: relative; top: -24rpx; }
.home-page .pill { transform: translateX(-80rpx); font-size: 14px; padding: 11rpx 20rpx; flex-shrink: 0; white-space: nowrap; }
.home-page .brand { transform: translateX(40rpx) scaleY(1.15); transform-origin: left center; font-family: 'AITI Bungee', sans-serif; font-weight: 400; font-size: 100rpx; letter-spacing: -0.25px; }
.brand-chatgpt { color: #45AF9B; }
.brand-claude { color: #FF916B; }
.brand-deepseek { color: #6FB7F6; }
.brand-kimi { color: #343438; }
.hero-heading { margin: 48rpx 80rpx 0 40rpx; }
.hero-heading .title { display: block; transform: scaleY(1.1); transform-origin: center; font-size: 44rpx; font-weight: 400; line-height: 1.35; text-align: justify; text-align-last: justify; letter-spacing: 0; white-space: nowrap; padding: 0; }
.title-prefix { font-weight: 400; color: #343438; }
.title-emphasis { font-family: 'AITI Bungee', sans-serif; font-size: 46rpx; font-weight: 700; color: #202020; }
.identity { position: relative; overflow: hidden; margin: 32rpx 4px 0 0; padding: 22rpx; border: 2px solid #202020; border-radius: 12px; box-shadow: 4px 4px 0 #202020; background: #A8C7FA; }
