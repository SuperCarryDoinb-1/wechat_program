%22%23fff%22%2F%3E%3Cpath%20opacity%3D%22.1%22%20d%3D%22M14.03%2018.35a5.32%205.32%200%201%200%200-10.65%205.32%205.32%200%200%200%200%2010.65Z%22%20fill%3D%22%23fff%22%2F%3E%3C%2Fg%3E%3Cg%20transform%3D%22translate(91%20160)%20scale(.8)%22%3E%3Cpath%20d%3D%22M75.08%2012a1.37%201.37%200%200%201%201.26.83%2015.26%2015.26%200%200%201-15.67%2022.03%2015.2%2015.2%200%200%201-9.53-5.26%201.48%201.48%200%200%201%201.15-2.09c.3-.04.61.02.88.17a12.52%2012.52%200%200%200%2016.54%202.35c4.01-2.7%207.51-8.54%204.1-16.07a1.48%201.48%200%200%201%20.77-1.83c.16-.08.34-.12.51-.13Z%22%20fill%3D%22%23202020%22%2F%3E%3C%2Fg%3E%3Cellipse%20cx%3D%22107%22%20cy%3D%22175%22%20rx%3D%229%22%20ry%3D%225%22%20fill%3D%22%23F59EA6%22%2F%3E%3Cellipse%20cx%3D%22178%22%20cy%3D%22175%22%20rx%3D%229%22%20ry%3D%225%22%20fill%3D%22%23F59EA6%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E"); background-repeat: no-repeat; background-position: center; background-size: auto 100%; }
.hero-image { display: block; width: 100%; height: 356rpx; }
.start-area { margin-top: 10rpx; margin-right: 4px; }
.start-button { display: flex; align-items: center; justify-content: center; padding: 15px 24px; font-size: 17px; font-weight: 800; background: #FFE17D; }
.assistant-showcase { margin: 24rpx 4px 0 0; }
.assistant-strip { display: block; width: 100%; height: 224rpx; object-fit: contain; }
.assistant-names { position: relative; top: -28rpx; display: flex; align-items: center; }
.assistant-name { flex: 1; min-width: 0; text-align: center; font-size: 12px; line-height: 1.5; font-weight: 600; color: #505050; }
.home-page .footer { margin-top: 32rpx; }
.diagnostics { margin-top: 36rpx; }
.diagnostics-title { font-size: 14px; margin-bottom: 8rpx; }
.diagnostics .secondary { margin: 20rpx 0; }
.friend-banner { display: flex; gap: 16rpx; margin-top: 24rpx; padding: 22rpx; background: #C9B6FF; border: 2px solid #202020; border-radius: 8px; color: #202020; line-height: 1.6; font-size: 14px; }
.friend-symbol { font-size: 36rpx; }
.privacy-link { color: #202020; background: transparent; font-size: 12px; padding: 12rpx; line-height: 2; text-decoration: none; }
@media (max-height: 600px) { .home-page { padding-top: calc(24rpx + 3vh); } }
@media (max-width: 340px) { .hero-heading { margin-top: 36rpx; } .identity { margin-top: 24rpx; } .specimen, .hero-image { height: 312rpx; } }
