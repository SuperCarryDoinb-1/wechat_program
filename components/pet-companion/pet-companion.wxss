@import "../../utils/pet-animation.wxss";
/* No layout space or full-screen touch shield: only the pet handles touches. */
:host { display: block; width: 0; height: 0; pointer-events: none; }
.pet-walker { position: fixed; top: 0; left: 0; z-index: 2147483000; pointer-events: auto; }
.pet-walker.is-passive { pointer-events: none; }
.pet-trail { position: fixed; inset: 0; z-index: 2147482999; pointer-events: none; }
.pet-trail.is-fading { opacity: 0; transition: opacity 700ms ease-out; }
.pet-trail-segment { position: absolute; height: 5px; border-radius: 5px; transform-origin: 0 50%; box-shadow: 0 0 8px 3px currentColor, 0 0 17px currentColor; }
.pet-walker.action-heart { transition: transform 40ms linear; }
.action-heart .pet-breathe { animation: none; }
.pet-walker.action-blink { transition: none; }
.action-blink .pet-facing { animation: pet-blink 240ms ease-out; }
.pet-bubble { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); padding: 8px 10px; border-radius: 14px; background: #fff; color: #69428b; font-size: 14px; white-space: nowrap; box-shadow: 0 3px 14px #bb88cc55; pointer-events: none; }
.pet-bubble::after { content: ''; position: absolute; top: 100%; left: 45%; border: 6px solid transparent; border-top-color: #fff; }
.pet-bubble.is-below { top: 100%; bottom: auto; }
.pet-bubble.is-below::after { top: auto; bottom: 100%; border-top-color: transparent; border-bottom-color: #fff; }
@keyframes pet-blink { 0% { opacity: 1; filter: brightness(1); } 35%, 45% { opacity: 0; filter: brightness(3); } 100% { opacity: 1; filter: brightness(1); } }
.is-passive .pet-breathe { animation-duration: 4s; }
.pet-body.mood-nod.beat-0 { animation: pet-nod-a .6s ease-in-out 2; }
.pet-body.mood-nod.beat-1 { animation: pet-nod-b .6s ease-in-out 2; }
