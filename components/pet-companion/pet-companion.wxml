<view wx:if="{{positioned && available && !imageFailed}}" class="pet-walker {{!active ? 'is-paused' : ''}} {{passive ? 'is-passive' : ''}} {{motionReady ? 'is-moving' : ''}} {{dragging ? 'is-dragging' : ''}} {{motionSuspended ? 'is-suspended' : ''}}" style="width: {{size}}px; height: {{size}}px; opacity: {{passive && !confirmed ? 0 : 1}}; transform: translate3d({{x}}px, {{y}}px, 0);" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel">
  <view class="pet-facing" style="transform: scaleX({{facing}});">
    <view class="pet-breathe">
    <view class="pet-body mood-{{mood}} beat-{{beat}}" role="{{passive ? 'img' : 'button'}}" aria-label="{{passive ? '陪伴答题的小宠物' : '点击与小宠物互动，可以向任意方向拖动'}}" catchtap="tapPet">
      <image class="pet-image" src="{{image}}" mode="aspectFit" bindload="onImageLoad" binderror="onImageError" />
    </view>
    </view>
  </view>
</view>
